# A2 / Active Oberon sources. Without this they are detected as Modula-2,
# and some of them as AMPL.
*.Mod linguist-language=Oberon
*.mod linguist-language=Oberon

# .Tool files are A2 command lists, not shell scripts.
*.Tool linguist-detectable=false

# docs/ holds the A2 module documentation exported from the A2 system
# (machine-generated XHTML, input to tools/build_site.py) — not repo source.
docs/** linguist-generated=true
